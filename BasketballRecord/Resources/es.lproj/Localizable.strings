"settings_doc_privacy_content" = "Por defecto, esta aplicación almacena el juego, el equipo, el jugador y el ajuste de los datos localmente en el dispositivo y no auto-upload a los servidores del desarrollador. \\n Sólo cuando usted importa activamente, exporta, comparte, usa sincronización Bluetooth o genera un resumen de IA se transmitirán datos relacionados. \\n Puede administrar o eliminar DeepSeek API Key en cualquier momento en Ajustes.";
"settings_doc_privacy_network_item1_desc" = "La colaboración Bluetooth transfiere datos sólo después de conectar y confirmar, y sólo entre los dispositivos participantes.";
"settings_doc_privacy_network_item1_title" = "Colaboración Bluetooth";
"settings_doc_privacy_network_item2_desc" = "Sólo cuando configura DeepSeek API Key y solicite activamente un resumen requerirá datos de juego para DeepSeek.";
"settings_doc_privacy_network_item2_title" = "AI Summary (Optional)";
"settings_doc_privacy_network_item3_desc" = "DeepSeek API Key se almacena en iOS Keychain y se puede eliminar en Ajustes en cualquier momento.";
