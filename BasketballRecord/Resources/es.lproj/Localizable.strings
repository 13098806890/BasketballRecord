"settings_doc_privacy_network_title" = "Network &quot; Third-party Services";
"settings_doc_privacy_notice_item1_desc" = "Eliminar, sobreescribir y fusionar operaciones puede afectar a los datos existentes. Por favor, confirme antes de proceder.";
